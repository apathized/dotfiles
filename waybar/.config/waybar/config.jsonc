// waybar: top bar on the OLED, three transparent pills (left / center / right)
// text labels everywhere; the only icons are the tray (running apps) and waypaper
{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 20,
    "margin-right": 20,
    "spacing": 4,
    "reload_style_on_change": true,

    "modules-left":   ["cpu", "memory", "hyprland/workspaces"],
    "modules-center": ["hyprland/window", "clock", "custom/waypaper"],
    "modules-right":  ["tray", "wireplumber", "mpris", "custom/notifications", "custom/power"],

    "cpu": {
        "format": "cpu {usage}%",
        "on-click": "pkill -x btop || kitty --class btop btop",
        "interval": 2
    },
    "memory": {
        "format": "ram {used:0.1f}G",
        "on-click": "pkill -x btop || kitty --class btop btop",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{id}"
    },
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/waypaper": {
        "format": "󰋩",
        "tooltip": false,
        "on-click": "waypaper"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "wireplumber": {
        "format": "vol {volume}%",
        "format-muted": "muted",
        "on-click": "kitty --class wiremix wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "mpris": {
        "format": "{dynamic}",
        "format-paused": "paused · {dynamic}",
        "dynamic-len": 40
    },
    // not in modules-right (nm-applet covers it); kept here in case you want it back
    "network": {
        "format-ethernet": "eth",
        "format-wifi": "wifi {essid}",
        "format-disconnected": "offline",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "kitty --class nmtui nmtui"
    },
    "custom/notifications": {
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/notifications.sh",
        "interval": 2,
        "on-click": "dunstctl history-pop",
        "on-click-right": "dunstctl set-paused toggle",
        "on-click-middle": "dunstctl history-clear"
    },
    "custom/power": {
        "format": "power",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "logout": "uwsm stop",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
