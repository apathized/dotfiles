// waybar: top bar on the OLED, three transparent pills (left / center / right)
{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 20,
    "margin-right": 20,
    "spacing": 4,
    "reload_style_on_change": true,

    "modules-left":   ["cpu", "memory", "hyprland/workspaces"],
    "modules-center": ["hyprland/window", "clock"],
    "modules-right":  ["tray", "wireplumber", "mpris", "custom/notifications", "custom/power"],

    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },
    "memory": {
        "format": " {used:0.1f}G",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{id}"
    },
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "kitty --class wiremix wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "mpris": {
        "format": "{status_icon} {dynamic}",
        "dynamic-len": 40,
        "status-icons": { "playing": "", "paused": "" }
    },
    "network": {
        "format-ethernet": "󰈀",
        "format-wifi": " {essid}",
        "format-disconnected": "󰤭",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "kitty --class nmtui nmtui"
    },
    "custom/notifications": {
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/notifications.sh",
        "interval": 2,
        "on-click": "dunstctl history-pop",
        "on-click-right": "dunstctl set-paused toggle",
        "on-click-middle": "dunstctl history-clear"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "logout": "uwsm stop",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
