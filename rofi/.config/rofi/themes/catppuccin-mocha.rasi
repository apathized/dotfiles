/*
    Catppuccin Mocha — v2
    Floating search pill overlaid on header image.
    https://catppuccin.com/palette
*/

*{
    font: "FiraCode Nerd Font Light 11";

    // Base Surface
    base:     #1e1e2e;
    mantle:   #181825;
    crust:    #11111b;
    surface0: #313244;
    surface1: #45475a;
    surface2: #585b70;

    // Various Texts
    text:     #cdd6f4;
    subtext1: #bac2de;
    subtext0: #a6adc8;
    overlay2: #9399b2;
    overlay1: #7f849c;
    overlay0: #6c7086;

    // Accents
    rosewater: #f5e0dc;
    flamingo:  #f2cdcd;
    pink:      #f5c2e7;
    mauve:     #cba6f7;
    red:       #f38ba8;
    maroon:    #eba0ac;
    peach:     #fab387;
    yellow:    #f9e2af;
    green:     #a6e3a1;
    teal:      #94e2d5;
    sky:       #89dceb;
    sapphire:  #74c7ec;
    blue:      #89b4fa;
    lavender:  #b4befe;
}

window{
    transparency: "real";
    location: center;
    anchor: center;
    width: 800px;
    border-radius: 12px;
    border: 0px;
    background-color: transparent;
}

mainbox{
    spacing: 0px;
    padding: 0px;
    background-color: transparent;
    children: ["header", "inputbar", "listview"];
}

header{
    enabled: true;
    height: 80px;
    background-color: @mauve;
    expand: false;
}

// Floating pill on top of header image
inputbar{
    spacing: 8px;
    padding: 8px 14px;
    margin: 0px 16px 10px 16px; // inset from window edges, gap below before list
    background-color: #11111bdd;  // @crust @ ~87% opacity
    border-radius: 20px;
    border: 0px;
    text-color: @text;
    children: ["prompt", "entry", "mode-switcher"];
}

mode-switcher{
    enabled: true;
    expand: false;
    spacing: 6px;
    background-color: transparent;
    vertical-align: 0.5;
}

button{
    padding: 4px 14px;
    border-radius: 14px;
    background-color: #313244aa;  // @surface0 @ ~67% opacity
    text-color: @overlay1;
    cursor: pointer;
    vertical-align: 0.5;
}

button selected{
    background-color: @maroon;
    text-color: @base;
}

listview{
    enabled: true;
    columns: 1;
    lines: 7;
    cycle: false;
    scrollbar: false;
    dynamic: true;
    spacing: 2px;
    padding: 12px 8px 8px 8px;
    background-color: #1e1e2ecc;
    text-color: @text;
}

prompt{
    enabled: true;
    background-color: transparent;
    text-color: @maroon;
    vertical-align: 0.5;
}

entry{
    enabled: true;
    background-color: transparent;
    text-color: @text;
    placeholder: "type...";
    placeholder-color: @overlay0;
    vertical-align: 0.5;
}

element{
    enabled: true;
    spacing: 8px;
    padding: 6px 8px;
    background-color: transparent;
    text-color: @text;
    border-radius: 6px;
}

element selected{
    background-color: @maroon;
    text-color: @base;
}

element-icon{
    background-color: transparent;
    text-color: inherit;
    size: 20px;
}

element-text{
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}
