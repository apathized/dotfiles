{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/ryanm/.config/fastfetch/logo.txt",
        "padding": {
            "top": 0,
            "right": 0,
            "left": 7
        }
    },
    "display": {
        "color": {
            "keys": "38;2;158;194;251",
            "title": "1;38;2;137;180;250",
            "output": "38;2;205;214;244"
        },
        "percent": {
            "color": {
                "green": "38;2;166;227;161",
                "yellow": "38;2;249;226;175",
                "red": "38;2;243;139;168"
            }
        },
        "separator": " "
    },
    "modules": [
        // ── Last Surprise ── t=0.00 → 137;180;250 ───────────────────────
        {
            "type": "custom",
            "format": "\u001b[1;38;2;137;180;250m┌─────────────────────Last Surprise───────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  ",
            "keyColor": "38;2;137;180;250",
            "text": "~/.config/fastfetch/quotes.sh"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;137;180;250m└─────────────────────────────────────────────────────────┘"
        },
        // ── Hardware ── t=0.25 → 158;194;251 ────────────────────────────
        {
            "type": "custom",
            "format": "\u001b[1;38;2;158;194;251m┌────────────────────────Hardware─────────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "1;38;2;158;194;251"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "38;2;158;194;251",
            "showPeCoreCount": true,
            "percentType": 9
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "38;2;158;194;251"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "38;2;158;194;251",
            "percentType": 9
        },
        {
            "type": "disk",
            "key": "└ └󰋊 ",
            "keyColor": "38;2;158;194;251",
            "percentType": 9
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;158;194;251m└─────────────────────────────────────────────────────────┘"
        },
        "break",
        // ── Software ── t=0.50 → 179;208;253 ────────────────────────────
        {
            "type": "custom",
            "format": "\u001b[1;38;2;179;208;253m┌────────────────────────Software─────────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "38;2;179;208;253"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "38;2;179;208;253"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "38;2;179;208;253"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "38;2;179;208;253"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "38;2;179;208;253"
        },
        "break",
        // ── DE / WM ── t=0.75 → 199;221;254 ─────────────────────────────
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "38;2;199;221;254"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "38;2;199;221;254"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "38;2;199;221;254"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "38;2;199;221;254"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "38;2;199;221;254"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;199;221;254m└─────────────────────────────────────────────────────────┘"
        },
        "break",
        // ── Uptime / Age / DT ── t=1.00 → 220;235;255 ───────────────────
        {
            "type": "custom",
            "format": "\u001b[1;38;2;220;235;255m┌────────────────────Uptime / Age / DT────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "38;2;220;235;255",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "38;2;220;235;255"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "38;2;220;235;255"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;220;235;255m└─────────────────────────────────────────────────────────┘"
        },
        // ── color swatch ─── gradient blue → white ───────────────────────
        {
            "type": "custom",
            "format": "  \u001b[38;2;137;180;250m●\u001b[38;2;149;188;251m ●\u001b[38;2;161;196;251m ●\u001b[38;2;173;204;252m ●\u001b[38;2;184;211;253m ●\u001b[38;2;196;219;254m ●\u001b[38;2;208;227;254m ●\u001b[38;2;220;235;255m ●"
        }
    ]
}
