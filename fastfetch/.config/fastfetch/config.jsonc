// fastfetch: default modules, font line trimmed to just the GTK font
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "file", "source": "/home/ryanm/.config/fastfetch/logo.txt", "color": { "1": "38;2;251;73;52" }, "padding": { "top": 1, "right": 4 } },
    "display": { "color": { "keys": "38;2;146;131;116" } },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        { "type": "font", "format": "{3}" },
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
