{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/ryanm/.config/fastfetch/logo.txt",
        "padding": {
            "top": 0,
            "right": 0,
            "left": 7
        }
    },
    "display": {
        "color": {
            "keys": "38;2;180;190;254",
            "title": "1;38;2;203;166;247",
            "output": "38;2;205;214;244"
        },
        "percent": {
            "color": {
                "green": "38;2;166;227;161",
                "yellow": "38;2;249;226;175",
                "red": "38;2;243;139;168"
            }
        },
        "separator": " "
    },
    "modules": [
        // ── Last Surprise ── Flamingo #f2cdcd ───────────────────────────
        {
            "type": "custom",
            "format": "\u001b[1;38;2;242;205;205m┌─────────────────────Last Surprise───────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  ",
            "keyColor": "38;2;242;205;205",
            "text": "~/.config/fastfetch/quotes.sh"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;242;205;205m└─────────────────────────────────────────────────────────┘"
        },
        // ── Hardware ── Blue #89b4fa ─────────────────────────────────────
        {
            "type": "custom",
            "format": "\u001b[1;38;2;137;180;250m┌────────────────────────Hardware─────────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "1;38;2;137;180;250"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "38;2;137;180;250",
            "showPeCoreCount": true,
            "percentType": 9
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "38;2;137;180;250"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "38;2;137;180;250",
            "percentType": 9
        },
        {
            "type": "disk",
            "key": "└ └󰋊 ",
            "keyColor": "38;2;137;180;250",
            "percentType": 9
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;137;180;250m└─────────────────────────────────────────────────────────┘"
        },
        "break",
        // ── Software ── Green #a6e3a1 ────────────────────────────────────
        {
            "type": "custom",
            "format": "\u001b[1;38;2;166;227;161m┌────────────────────────Software─────────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "38;2;166;227;161"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "38;2;166;227;161"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "38;2;166;227;161"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "38;2;166;227;161"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "38;2;166;227;161"
        },
        "break",
        // ── DE / WM ── Green #a6e3a1 ─────────────────────────────────────
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "1;38;2;166;227;161"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "38;2;166;227;161"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "38;2;166;227;161"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "38;2;166;227;161"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "38;2;166;227;161"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;166;227;161m└─────────────────────────────────────────────────────────┘"
        },
        "break",
        // ── Uptime / Age / DT ── Teal #94e2d5 ───────────────────────────
        {
            "type": "custom",
            "format": "\u001b[1;38;2;148;226;213m┌────────────────────Uptime / Age / DT────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "38;2;148;226;213",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "38;2;148;226;213"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "38;2;148;226;213"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;148;226;213m└─────────────────────────────────────────────────────────┘"
        },
        // ── color swatch ────────────────────────────────────────────────
        {
            "type": "custom",
            "format": "  \u001b[38;2;203;166;247m●\u001b[38;2;137;180;250m ●\u001b[38;2;180;190;254m ●\u001b[38;2;245;194;231m ●\u001b[38;2;148;226;213m ●\u001b[38;2;166;227;161m ●\u001b[38;2;166;227;161m ●\u001b[38;2;243;139;168m ●"
        }
    ]
}
